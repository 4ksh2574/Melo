rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function approved() {
      return signedIn()
        && exists(/databases/$(database)/documents/members/$(request.auth.uid))
        && get(/databases/$(database)/documents/members/$(request.auth.uid)).data.active == true;
    }

    function approvedUid(uid) {
      return exists(/databases/$(database)/documents/members/$(uid))
        && get(/databases/$(database)/documents/members/$(uid)).data.active == true;
    }

    function follows(fromUid, toUid) {
      return exists(/databases/$(database)/documents/follows/$(fromUid + "_" + toUid));
    }

    function validConversationMembers(ids) {
      return ids is list
        && ids.size() >= 2
        && ids.size() <= 4
        && ids.toSet().size() == ids.size()
        && request.auth.uid in ids
        && approvedUid(ids[0])
        && approvedUid(ids[1])
        && (ids.size() < 3 || approvedUid(ids[2]))
        && (ids.size() < 4 || approvedUid(ids[3]));
    }

    function validConversationCreate(conversationId) {
      let data = request.resource.data;
      return approved()
        && data.keys().hasOnly([
          'type', 'memberIds', 'title', 'createdBy', 'createdAt', 'isPermanent'
        ])
        && data.createdBy == request.auth.uid
        && data.createdAt == request.time
        && validConversationMembers(data.memberIds)
        && (
          (
            data.type == 'direct'
            && data.memberIds.size() == 2
            && data.memberIds[0] < data.memberIds[1]
            && conversationId == data.memberIds[0] + "__" + data.memberIds[1]
            && !('title' in data.keys())
            && !('isPermanent' in data.keys())
          )
          ||
          (
            data.type == 'group'
            && data.title is string
            && data.title.size() > 0
            && data.title.size() <= 40
            && (
              (
                conversationId == 'the-four'
                && data.title == 'The Four'
                && data.memberIds.size() == 4
                && data.isPermanent == true
              )
              ||
              (
                conversationId != 'the-four'
                && !('isPermanent' in data.keys())
              )
            )
          )
        );
    }

    match /members/{uid} {
      // A signed-in user must read their own approval record before approved() can succeed.
      allow get: if signedIn() && (
        uid == request.auth.uid || (approved() && approvedUid(uid))
      );
      allow list: if approved();
      allow create, update, delete: if false;
    }

    match /follows/{followId} {
      allow read: if approved();
      allow create: if approved()
        && request.resource.data.keys().hasOnly(['followerUid', 'followedUid', 'createdAt'])
        && request.resource.data.followerUid == request.auth.uid
        && request.resource.data.followedUid is string
        && request.resource.data.followedUid != request.auth.uid
        && approvedUid(request.resource.data.followedUid)
        && followId == request.auth.uid + "_" + request.resource.data.followedUid;
      allow delete: if approved() && resource.data.followerUid == request.auth.uid;
      allow update: if false;
    }

    // New conversation model. Direct-message IDs are deterministic; group IDs are random.
    // A conversation is visible only to its approved members.
    match /conversations/{conversationId} {
      // Allow approved members to check whether a deterministic conversation ID exists.
      // Existing conversation data is still visible only to its listed members.
      allow get: if approved() && (
        !exists(/databases/$(database)/documents/conversations/$(conversationId))
        || request.auth.uid in resource.data.memberIds
      );
      allow list: if approved() && request.auth.uid in resource.data.memberIds;
      allow create: if validConversationCreate(conversationId);
      allow update: if approved()
        && request.auth.uid in resource.data.memberIds
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'disappearingAfterSeconds'
        ])
        && request.resource.data.disappearingAfterSeconds in [
          0, 300, 3600, 28800, 86400, 604800, 2419200
        ];
      allow delete: if false;

      match /messages/{messageId} {
        function conversationMember() {
          return approved()
            && exists(/databases/$(database)/documents/conversations/$(conversationId))
            && request.auth.uid in get(
              /databases/$(database)/documents/conversations/$(conversationId)
            ).data.memberIds;
        }

        allow read: if conversationMember();
        allow create: if conversationMember()
          && request.resource.data.keys().hasOnly(['uid', 'text', 'createdAt', 'expiresAt'])
          && request.resource.data.uid == request.auth.uid
          && request.resource.data.text is string
          && request.resource.data.text.size() > 0
          && request.resource.data.text.size() <= 4000
          && request.resource.data.createdAt == request.time
          && (
            !('expiresAt' in request.resource.data.keys())
            || (
              request.resource.data.expiresAt is timestamp
              && request.resource.data.expiresAt > request.time
            )
          );
        allow update: if false;
        allow delete: if conversationMember()
          && resource.data.keys().hasAny(['expiresAt'])
          && resource.data.expiresAt is timestamp
          && resource.data.expiresAt <= request.time;
      }
    }

    // Legacy The Four history remains readable during migration.
    match /rooms/the-four/messages/{messageId} {
      allow read: if approved();
      allow create: if approved()
        && request.resource.data.keys().hasOnly(['uid', 'displayName', 'text', 'createdAt'])
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.displayName is string
        && request.resource.data.displayName.size() <= 80
        && request.resource.data.text is string
        && request.resource.data.text.size() > 0
        && request.resource.data.text.size() <= 4000
        && request.resource.data.createdAt == request.time;
      allow update, delete: if false;
    }

    // Legacy direct-message history remains readable. The original app's
    // follow-before-chat creation rule is retained for backward compatibility.
    match /chats/{chatId} {
      allow read: if approved() && request.auth.uid in resource.data.memberIds;
      allow create: if approved()
        && request.resource.data.keys().hasOnly(['memberIds', 'createdAt'])
        && request.resource.data.memberIds is list
        && request.resource.data.memberIds.size() == 2
        && request.auth.uid in request.resource.data.memberIds
        && approvedUid(request.resource.data.memberIds[0])
        && approvedUid(request.resource.data.memberIds[1])
        && follows(
          request.auth.uid,
          request.resource.data.memberIds[0] == request.auth.uid
            ? request.resource.data.memberIds[1]
            : request.resource.data.memberIds[0]
        );
      allow update, delete: if false;

      match /messages/{messageId} {
        function legacyChatMember() {
          return approved()
            && exists(/databases/$(database)/documents/chats/$(chatId))
            && request.auth.uid in get(
              /databases/$(database)/documents/chats/$(chatId)
            ).data.memberIds;
        }

        allow read: if legacyChatMember();
        allow create: if legacyChatMember()
          && request.resource.data.keys().hasOnly(['uid', 'text', 'createdAt'])
          && request.resource.data.uid == request.auth.uid
          && request.resource.data.text is string
          && request.resource.data.text.size() > 0
          && request.resource.data.text.size() <= 4000
          && request.resource.data.createdAt == request.time;
        allow update, delete: if false;
      }
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}